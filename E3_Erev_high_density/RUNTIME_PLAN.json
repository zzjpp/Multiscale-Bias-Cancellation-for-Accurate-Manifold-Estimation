  "principle": "Execution-only acceleration; no estimator, scale, seed, query coordinate, reliability rule, or failure record may change.",
  "query_sharding": {
    "STSP": {
      "shards_per_geometry": 8,
      "maximum_concurrent_cpu_workers": 8,
      "merge_order": "global query index"
    },
    "DR": {
      "shards_per_geometry": 8,
      "maximum_concurrent_workers_per_gpu": 4,
      "merge_order": "global query index"
    },
    "YY": {
      "shards_per_geometry": 8,
      "maximum_concurrent_workers_per_gpu": 4,
      "merge_order": "global query index"
    }
  },
  "safe_caches": {
    "STSP": [
      "one cKDTree per shard and geometry",
      "reuse the mathematically identical fine-scale reference solve between Single and Multi only after equivalence passes"
    ],
    "DR": [
      "one CPU cKDTree per shard and geometry",
      "one immutable GPU observation array per shard and geometry"
    ],
    "YY": [
      "retain the existing common-start and maximum-radius candidate cache across all 28 scales"
    ]
  },
  "equivalence_gate": {
    "required_before_production": true,
